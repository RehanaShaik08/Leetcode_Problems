class Solution {
    public int firstUniqChar(String s) {
        char ch[]=s.toCharArray();
        int ar[]=new int[26];

        for(char c:ch){

ar[c-'a']++;
        }
        for(char c:ch){

if(ar[c-'a']==1){

    return (new String(ch).indexOf(c));
}
        }
        return -1;

        
    }
}
